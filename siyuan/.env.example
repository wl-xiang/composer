# SiYuan Docker Compose 部署环境变量
# 使用方法: cp .env.example .env 然后按需修改。
# 注意: .env 已被 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。

# ---------------- SiYuan ----------------
# 镜像版本,latest 跟随上游最新版,也可固定具体版本号
SIYUAN_VERSION=latest
# 容器名
SIYUAN_CONTAINER_NAME=siyuan
# 访问授权码:登录 Web 界面时的密码,请务必修改为强密码!
SIYUAN_ACCESS_AUTH_CODE=siyuan-auth-code
# Web 对外暴露的宿主机端口(容器内固定为 6806)
SIYUAN_PORT=6806
# 工作区数据目录(挂载到容器 /siyuan/workspace,存放笔记本、资源、配置等)
SIYUAN_WORKSPACE_DIR=./volumes/workspace
# 容器内进程运行的用户/组 ID(镜像 entrypoint 会自动将工作区 chown 为该 UID/GID)
SIYUAN_PUID=1000
SIYUAN_PGID=1000

# ---------------- 时区 ----------------
TZ=Asia/Shanghai
