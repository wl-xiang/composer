# Oracle 部署环境变量(三个 compose 共用)
# 使用方法:cp .env.example .env 然后按需修改;.env 含密码,请勿提交。
# 注意:多个 compose 不要在同一目录同时启用;若确需同跑,请为其中一个改开独立的数据目录与端口。

TZ=Asia/Shanghai

# ---------------- Oracle 11g XE(docker-compose.11g-amd64.yml,仅 amd64) ----------------
# 预置镜像(由 docker compose -f docker-compose.11g-amd64.yml up -d --build 构建)
ORACLE_11G_IMAGE=oracle-11g-preset:1.0.0
ORACLE_11G_CONTAINER_NAME=oracle-11g
ORACLE_11G_PORT=1522
ORACLE_11G_ORADATA_DIR=./volumes/oradata
ORACLE_11G_FRA_DIR=./volumes/fra
ORACLE_11G_MEM_LIMIT=4g
# 客户端会话字符集(影响 sqlplus/导出工具,NLS_LANG=AMERICAN_AMERICA.AL32UTF8)
ORACLE_11G_NLS_LANG=AMERICAN_AMERICA.AL32UTF8

# ---------------- Oracle 19c(docker-compose.19c-arm64.yml,仅 arm64) ----------------
# 预置镜像(由 docker compose -f docker-compose.19c-arm64.yml up -d --build 构建)
ORACLE_19C_IMAGE=oracle-19c-arm64-preset:1.0.0
ORACLE_19C_CONTAINER_NAME=oracle-19c-arm64
ORACLE_19C_PORT=1523
ORACLE_19C_ORADATA_DIR=./volumes/oradata
ORACLE_19C_MEM_LIMIT=4g
# SYS/SYSTEM 管理员密码(仅首次建库时生效,避免使用含 @ 的密码)
ORACLE_19C_SYS_PASSWORD=SysOracle123

# ---------------- Oracle 23ai Free(docker-compose.23ai-none.yml,amd64+arm64) ----------------
# 预置镜像(由 docker compose -f docker-compose.23ai-none.yml up -d --build 构建)
ORACLE_23AI_IMAGE=oracle-23ai-preset:1.0.0
ORACLE_23AI_CONTAINER_NAME=oracle-23ai
ORACLE_23AI_PORT=1521
ORACLE_23AI_ORADATA_DIR=./volumes/oradata
ORACLE_23AI_MEM_LIMIT=4g
# SYS/SYSTEM 管理员密码(仅首次建库时生效,避免使用含 @ 的密码)
ORACLE_SYS_PASSWORD=SysOracle123
