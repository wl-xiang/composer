# Oracle 11g XE 部署环境变量
# 使用方法:cp .env.example .env 然后按需修改。
# 注意:.env 已被根目录 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。

# ---------------- 镜像与容器 ----------------
# XE 镜像(社区维护,仅限开发/测试)
ORACLE_XE_IMAGE=oracleinanutshell/oracle-xe-11g:latest
# 容器名
ORACLE_XE_CONTAINER_NAME=oracle-11g-xe
# 宿主机端口(容器内固定为 1521),与 oracle/11g 服务的 1522 区分开
ORACLE_XE_PORT=1521
# 容器时区
TZ=Asia/Shanghai

# ---------------- 数据目录 ----------------
# 数据文件目录(宿主机)→ 容器内 /u01/app/oracle/oradata
ORACLE_XE_ORADATA_DIR=./volumes/oradata
# Data Pump 导入导出目录(宿主机)→ 容器内 /u01/app/oracle/dpdump
ORACLE_XE_DUMP_DIR=./volumes/dump
