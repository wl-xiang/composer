# Oracle 11g(Enterprise Edition)部署环境变量
# 使用方法:cp .env.example .env 然后按需修改。
# 注意:.env 已被根目录 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。

# ---------------- 镜像与容器 ----------------
# 社区镜像,仅限开发/测试使用
ORACLE_IMAGE=yycx/oracle11:11.2.0.4
# 国内拉取镜像较慢时,改用华为云镜像仓库(需要放开注释):
# ORACLE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/yycx/oracle11:11.2.0.4
# 容器名
ORACLE_CONTAINER_NAME=oracle-11g
# 宿主机端口(容器内固定为 1521),与 oracle/11g-xe 服务的 1521 区分开
ORACLE_PORT=1522
# 容器时区
TZ=Asia/Shanghai

# ---------------- 数据目录(宿主机本地映射,不使用具名卷) ----------------
# 数据文件目录 → 容器内 /opt/oracle/app/oradata/orcl
ORACLE_ORADATA_DIR=./volumes/oradata
# 快速恢复区目录 → 容器内 /opt/oracle/app/fast_recovery_area/orcl
ORACLE_FRA_DIR=./volumes/fra
# Data Pump 导入导出目录 → 容器内 /opt/oracle/dpdump
ORACLE_DUMP_DIR=./volumes/dump
