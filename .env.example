# Gitea Docker Compose 部署环境变量
# 使用方法: cp .env.example .env 然后按需修改。
# 注意: .env 已被 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。

# ---------------- Gitea ----------------
# Gitea 镜像版本,可选 latest、1 或具体版本号,详见官方文档
GITEA_VERSION=28.2.0
# 容器内运行 Gitea 的用户/组 ID
# 使用宿主机目录(host volume)时,应与数据目录属主的 UID/GID 一致
USER_UID=1000
USER_GID=1000
# Web / SSH 对外暴露的宿主机端口(容器内固定为 3000 和 22)
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222
# Gitea 数据目录(挂载到容器 /data,含仓库、配置 app.ini 等)
GITEA_DATA_DIR=./gitea

# ---------------- PostgreSQL ----------------
# PostgreSQL 镜像版本
POSTGRES_VERSION=18
POSTGRES_USER=gitea
POSTGRES_DB=gitea
# 数据库密码:请在首次启动前修改为强密码!
POSTGRES_PASSWORD=gitea
# PostgreSQL 数据目录
POSTGRES_DATA_DIR=./postgres
