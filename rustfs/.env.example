# RustFS Docker Compose 部署环境变量
# 使用方法: cp .env.example .env 然后按需修改。
# 注意: .env 已被 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。

# ---------------- 镜像 ----------------
# RustFS 镜像版本,详见 https://hub.docker.com/r/rustfs/rustfs
RUSTFS_IMAGE=rustfs/rustfs:latest
# 权限修复辅助容器镜像(仅用于 chown,可保持 alpine)
RUSTFS_HELPER_IMAGE=alpine

# ---------------- 端口 ----------------
# S3 API 对外暴露的宿主机端口(容器内固定为 9000)
RUSTFS_S3_PORT=9000
# Web 控制台对外暴露的宿主机端口(容器内固定为 9001)
RUSTFS_CONSOLE_PORT=9001

# ---------------- 账号 ----------------
# S3 Access Key:请在首次启动前修改,勿用默认值!
RUSTFS_ACCESS_KEY=rustfsadmin
# S3 Secret Key:请在首次启动前修改,勿用默认值!
RUSTFS_SECRET_KEY=rustfsadmin

# ---------------- 数据目录(bind 绑定) ----------------
# 4 个数据盘目录 + 1 个日志目录,全部为宿主机本地目录绑定。
# 重要:首次启动前请先创建这些目录(可用一条命令: mkdir -p ./volumes/rustfs{0,1,2,3} ./volumes/logs),
#       并确保目录属主为 10001:10001 或由 compose 中的 permission helper 自动修复,详见 README.md。
RUSTFS_DATA_0_DIR=./volumes/rustfs0
RUSTFS_DATA_1_DIR=./volumes/rustfs1
RUSTFS_DATA_2_DIR=./volumes/rustfs2
RUSTFS_DATA_3_DIR=./volumes/rustfs3
RUSTFS_LOGS_DIR=./volumes/logs

# ---------------- 其他 ----------------
# 严格的磁盘拓扑校验开关:生产环境保持 false;
# 仅本地测试想跳过校验时才显式改为 true
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false
