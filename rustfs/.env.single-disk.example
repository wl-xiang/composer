# RustFS 单机单盘(SNSD)Docker Compose 部署环境变量
# 使用方法: cp .env.single-disk.example .env 然后按需修改。
# 注意: .env 已被 .gitignore 忽略,请勿提交包含真实密码的 .env 文件。
# 说明文档见 SINGLE-DISK-DEPLOYMENT.md。

# ---------------- 镜像 ----------------
# RustFS 镜像版本,详见 https://hub.docker.com/r/rustfs/rustfs
RUSTFS_IMAGE=rustfs/rustfs:latest
# 权限修复辅助容器镜像(仅用于 chown,可保持 alpine)
RUSTFS_HELPER_IMAGE=alpine

# ---------------- 端口 ----------------
# S3 API 对外暴露的宿主机端口(容器内固定为 9000)
RUSTFS_S3_PORT=9000
# Web 控制台对外暴露的宿主机端口(容器内固定为 9001)
RUSTFS_CONSOLE_PORT=9001

# ---------------- 账号 ----------------
# S3 Access Key:请在首次启动前修改,勿用默认值!
# 仅在数据目录为空(首次初始化)时生效,已有数据后需在控制台或 S3 API 中修改
RUSTFS_ACCESS_KEY=rustfsadmin
# S3 Secret Key:请在首次启动前修改,勿用默认值!
RUSTFS_SECRET_KEY=rustfsadmin

# ---------------- 数据目录(bind 绑定) ----------------
# 单盘模式只使用 1 个数据目录 + 1 个日志目录,全部为宿主机本地目录绑定。
# 重要:首次启动前请先创建这些目录(mkdir -p ./volumes/rustfs0 ./volumes/logs),
#       并确保目录属主为 10001:10001 或由 compose 中的 permission helper 自动修复,
#       详见 SINGLE-DISK-DEPLOYMENT.md。
RUSTFS_DATA_0_DIR=./volumes/rustfs0
RUSTFS_LOGS_DIR=./volumes/logs

# ---------------- 其他 ----------------
# 单盘模式无需绕过磁盘校验,保持 false;
# 该开关仅供本地测试/CI 强行跳过物理盘校验使用
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false
